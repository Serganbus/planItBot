includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 6
    paths:
        - app/
        - config/
        - routes/
        - database/
    excludePaths:
        - app/Models/*  # Eloquent-модели покрыты миграциями/тестами; магия фасадов не анализируется
    treatPhpDocTypesAsCertain: false
